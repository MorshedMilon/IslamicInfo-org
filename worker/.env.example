# IslamicInfo.org API Proxy Worker Local Environment Variables Template
# Copy this file to '.dev.vars' (for wrangler local development) or '.env' and fill in your keys.
# Do not commit your actual '.dev.vars' or '.env' files to git.

# Gemini API key (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# hadithapi.com — register at https://hadithapi.com, key appears on your profile.
# Passed server-side as ?apiKey=. NEVER expose to the browser.
HADITH_API_KEY=your-hadithapi-key-here
